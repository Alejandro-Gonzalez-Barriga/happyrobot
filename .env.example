# HappyRobot Carrier Sales API - Environment Variables
# Copy this file to .env and fill in the values

# API authentication key (required)
API_KEY=hr-secret-key-2026

# FMCSA API key for real carrier verification
# Get yours at: https://mobile.fmcsa.dot.gov/developer/home.page
# If blank, the system uses mock verification logic
FMCSA_API_KEY=
